; Engine configuration file.
; Godot 4.7.2 — Northeast: The Russian Invasion

config_version=5

[application]

config/name="Northeast: The Russian Invasion"
config/description="Fictional winter survival, January 2031. First slice: Heihe riverfront."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.04, 0.05, 0.07, 1)

[autoload]

GameState="*res://scripts/game/game_state.gd"
CombatHooks="*res://scripts/combat/combat_hooks.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.03, 0.04, 0.06, 1)
lights_and_shadows/directional_shadow/size=2048

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="npc"
